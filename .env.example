# Copiar a .env.local y completar. .env.local está gitignoreado.

# --- LiveKit ---
# El trunk SIP y el dispatch rule tienen que vivir en ESTE proyecto, que es
# donde el worker se registra. Ojo: livekit.toml apunta a otro proyecto.
LIVEKIT_URL=wss://tu-proyecto.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Base de conocimiento (Supabase + pgvector) ---
DATABASE_URL=postgresql://usuario:password@host:5432/postgres

# --- Embeddings y reranking ---
COHERE_API_KEY=

# --- Retrieval (opcionales, con defaults sanos en rag/config.py) ---
# TOP_K=3                 # fragmentos que se le pasan al LLM
# RAG_K_VECTOR=20         # candidatos que trae pgvector antes del rerank
# RAG_TIMEOUT_S=2.5       # presupuesto total de la tool de búsqueda
# RAG_MIN_SCORE=0.0       # piso de relevancia; calibrar, no adivinar

# --- Telefonía (Fase 3) ---
# ID del outbound trunk de LiveKit, necesario para derivar al 911.
# Se obtiene con: lk sip outbound list
# SIP_OUTBOUND_TRUNK_ID=
# Número al que se deriva. En la demo es un celular propio, no el 911 real.
# Móviles argentinos en E.164 llevan el 9 después del país y SIN el 15:
# +54 9 <área> <número>. Es un footgun clásico: probalo con
# `lk sip participant create --call ... --wait` antes de cablearlo.
# NUMERO_EMERGENCIAS=+549XXXXXXXXXX

# --- Logging ---
# LOG_LEVEL=INFO

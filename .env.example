# Copiar a .env.local y completar. .env.local no se sube a git.

# --- RAG: base de protocolos (Supabase, pooler en el puerto 6543) ---
DATABASE_URL=
RAG_TABLE=chunks_gemini
# Embeddings de las consultas (Google AI Studio) y rerank opcional (Cohere)
GEMINI_API_KEY=
COHERE_API_KEY=

# --- LLM ---
GROQ_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
# off = sin proveedor de respaldo. Con el agente de LiveKit y sin credenciales
# de LiveKit hay que ponerlo en off (su respaldo pasa por el gateway de LiveKit).
# LLM_FALLBACK=on
# Un LLM propio compatible con OpenAI (solo orquestador), p. ej. Ollama:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=

# --- Voz ---
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
# Solo orquestador: cartesia (por defecto) o deepgram como voz principal.
# TTS_PROVIDER=cartesia

# --- LiveKit: solo para agent.py (agent.py dev, lk agent deploy) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Orquestador propio: python -m orquestador (ver docs/orquestador.md) ---
# ORQUESTADOR_HOST=127.0.0.1
# ORQUESTADOR_PUERTO=8787
# Páginas web que pueden conectarse, separadas por coma.
# ORQUESTADOR_ORIGENES=http://localhost:3000
# Si se define, cada conexión tiene que traer un pase firmado con este secreto
# (el mismo valor va en el frontend). Obligatorio fuera de tu máquina.
# ORQUESTADOR_SECRETO=

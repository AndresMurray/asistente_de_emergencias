# Copiar a .env.local y completar. .env.local está gitignoreado.

# --- LiveKit ---
# El trunk SIP y el dispatch rule tienen que vivir en ESTE proyecto, que es
# donde el worker se registra. Ojo: livekit.toml apunta a otro proyecto.
LIVEKIT_URL=wss://tu-proyecto.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Base de conocimiento (Supabase + pgvector) ---
DATABASE_URL=postgresql://usuario:password@host:5432/postgres

# --- Embeddings y reranking ---
# OJO: si es una key Trial, el tope es 10 llamadas/minuto y cada turno gasta 2
# (embed + rerank). O sea que en una llamada de más de ~5 turnos por minuto el
# reranker empieza a devolver 429. No se cae: degrada al orden del coseno solo
# (ver rag/retriever.py), pero se pierde la calidad del rerank. Para una demo
# con jurado, conviene una key de producción.
COHERE_API_KEY=

# --- Retrieval (opcionales, con defaults ya calibrados en rag/config.py) ---
# TOP_K=3                 # fragmentos que se le pasan al LLM
# RAG_K_VECTOR=20         # candidatos que trae pgvector antes del rerank
# RAG_TIMEOUT_S=4.0       # presupuesto total de la tool de búsqueda
# RAG_MIN_SCORE=0.45      # piso de coseno, cuando el rerank está apagado o falló
# RAG_RERANK=1            # 0 para apagar el reranking
# RAG_RERANK_MODEL=rerank-v3.5
# RAG_MIN_RERANK_SCORE=0.08   # piso del reranker; separa mucho mejor que el coseno
# RAG_TABLE=chunks        # chunks_legacy_v1 tiene el corpus viejo, para comparar

# --- Logging ---
# LOG_LEVEL=INFO

